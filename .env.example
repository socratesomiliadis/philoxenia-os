# The Convex CLI creates CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL in .env.local.
# Keep this file as a reference; do not overwrite an existing .env.local.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Configure these in the CONVEX BACKEND environment, not as NEXT_PUBLIC values:
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<random secret, at least 32 characters>
# GOOGLE_CLIENT_ID=<Google Web application OAuth client ID>
# GOOGLE_CLIENT_SECRET=<Google OAuth client secret>
# ORGANIZER_EMAILS=s.omiliadis@gmail.com

# Stage 2: optional mission generation, configured in the CONVEX BACKEND.
# Templates remain available without AI credentials.
# MISSION_AI_PROVIDER=groq
# MISSION_AI_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=<your Groq API key>
# To use Google instead, set MISSION_AI_PROVIDER=google,
# MISSION_AI_MODEL to your available Gemini model, and:
# GOOGLE_GENERATIVE_AI_API_KEY=<your Google AI API key>

# Stage 5: optional transactional email, configured in the CONVEX BACKEND.
# In-app notifications work without an email provider.
# RESEND_API_KEY=<your Resend API key>
# EMAIL_FROM=Philoxenia <notifications@your-verified-domain.example>
# SITE_URL must be the app origin used by recipients.

# Stage 6: optional event imports, configured in the CONVEX BACKEND.
# Luma iCal uses a public subscription URL and needs no API key.
# Sources remain disabled until an organizer enables them in Manage imports.
# SERPAPI_API_KEY=<your SerpApi private key>
# Set provider account spending limits; Philoxenia's reservations cover only this app.

# Stage 7 production release: see RELEASE.md.
# Production SITE_URL=https://philoxenia-os.vercel.app on the production Convex backend.
# Set CONVEX_DEPLOY_KEY only in Vercel's Production environment, never as NEXT_PUBLIC.
# pnpm build:release injects NEXT_PUBLIC_CONVEX_URL and derives its matching auth site URL.
# Keep development .env.local and production credentials separate.
